{
  "name": "nexus",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "nexus",
      "version": "1.0.0",
      "workspaces": [
        "packages/agent-core",
        "apps/desktop",
        "apps/vscode-extension"
      ]
    },
    "apps/desktop": {
      "name": "@nexus/desktop",
      "version": "1.0.0",
      "dependencies": {
        "@nexus/agent-core": "*"
      }
    },
    "apps/vscode-extension": {
      "name": "nexus-vscode",
      "version": "1.0.0",
      "dependencies": {
        "@nexus/agent-core": "*"
      },
      "engines": {
        "vscode": "^1.85.0"
      }
    },
    "node_modules/@nexus/agent-core": {
      "resolved": "packages/agent-core",
      "link": true
    },
    "node_modules/@nexus/desktop": {
      "resolved": "apps/desktop",
      "link": true
    },
    "node_modules/nexus-vscode": {
      "resolved": "apps/vscode-extension",
      "link": true
    },
    "packages/agent-core": {
      "name": "@nexus/agent-core",
      "version": "1.0.0"
    }
  }
}
